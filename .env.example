# ── GitHub ──────────────────────────────────────────────────────────────────
# Personal Access Token (classic) — needs: public_repo, read:org
# Get one at: https://github.com/settings/tokens
# With a PAT you get 5,000 req/h instead of 60 req/h (unauthenticated)
GITHUB_TOKEN=ghp_your_token_here

# ── Flagsmith ────────────────────────────────────────────────────────────────
# Environment API key (Server-side) from Flagsmith dashboard
# Settings → Environments → your env → API Keys → Server-side
FLAGSMITH_ENV_KEY=ser.your_key_here

# Flag name — must match what you create in Flagsmith dashboard
FLAGSMITH_FLAG_NAME=triage_strategy

# Variant names — must match the multivariate values in Flagsmith
FLAGSMITH_VARIANT_A=answer_first
FLAGSMITH_VARIANT_B=clarify_first

# ── Experiment config ─────────────────────────────────────────────────────
# How many issues to scrape total
TOTAL_ISSUES=400

# Win probability threshold to auto-roll winner
WIN_PROBABILITY_THRESHOLD=0.90

# Sleep between Flagsmith API calls (seconds) — be polite to the API
API_SLEEP=0.05
